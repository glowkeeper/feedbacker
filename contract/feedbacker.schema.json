            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModerationContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "judgements": {

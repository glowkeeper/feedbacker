            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "programme",
        "module",
        "staff_roles",
        "cohort_size",
        "multiple_groups",
        "band_distribution",
        "sample_note",
        "provenance"

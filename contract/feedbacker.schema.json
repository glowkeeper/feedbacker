{
  "$defs": {
    "AISuggestion": {
      "additionalProperties": false,
      "description": "A model's second reading for one criterion. A suggestion, never a mark.",
      "properties": {
        "call": {
          "$ref": "#/$defs/ModelCall"
        },
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "draft_comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceQuote"
          },
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "kind": {
          "const": "ai_suggestion",
          "default": "ai_suggestion",
          "type": "string"
        },
        "missing_evidence": {
          "default": false,
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "rationale": {
          "default": "",
          "type": "string"
        },
        "submission_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "suggested_level_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None when the model could not suggest a level."
        }
      },
      "required": [
        "id",
        "submission_id",
        "criterion_id",
        "call",
        "provenance"
      ],
      "title": "AISuggestion",
      "type": "object"
    },
    "Actor": {
      "additionalProperties": false,
      "description": "Who or what performed a step. Labels are roles, never real names.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "label": {
          "description": "Role label or model identifier, e.g. 'moderator' or a model ID.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "moderator",
        "original_marker",
        "model",
        "system"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "Annotation": {
      "additionalProperties": false,
      "description": "An inline comment the marker attached to a passage of the work.\n\nPositions are approximate: ``page`` is the page of the marked report, and\n``position`` is the marker's height on that page (0 = top, 1 = bottom).\n``anchor_text`` is only ever an approximate match, never presented as exact.",
      "properties": {
        "anchor_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An approximate passage the comment refers to, if known."
        },
        "criterion_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The criterion tag on the comment, as written."
        },
        "number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The marker's comment number."
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "position": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "AnonymisedText": {
      "additionalProperties": false,
      "description": "Redacted text. Offsets in ``redactions`` refer to the extract text.",
      "properties": {
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "redactions": {
          "items": {
            "$ref": "#/$defs/Redaction"
          },
          "type": "array"
        },
        "text": {
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "text",
        "text_sha256",
        "provenance"
      ],
      "title": "AnonymisedText",
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "description": "The moderator's explicit approval of anonymised text for model use.",
      "properties": {
        "approved_at": {
          "format": "date-time",
          "type": "string"
        },
        "approved_by": {
          "$ref": "#/$defs/Actor"
        },
        "approved_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "approved_text_sha256",
        "approved_by",
        "approved_at"
      ],
      "title": "Approval",
      "type": "object"
    },
    "BandCount": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "label",
        "count"
      ],
      "title": "BandCount",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "description": "A structural unit of extracted text; offsets index into ``Extract.text``.",
      "properties": {
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/BlockKind"
        },
        "level": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Heading level, if a heading."
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page number, for PDFs."
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start",
        "end"
      ],
      "title": "Block",
      "type": "object"
    },
    "BlockKind": {
      "enum": [
        "heading",
        "paragraph",
        "table_row"
      ],
      "title": "BlockKind",
      "type": "string"
    },
    "Brief": {
      "additionalProperties": false,
      "description": "The assessment brief. Confidential assessment material, not student data.\n\nIt follows the submission pipeline: extracted locally, redacted (staff\nnames and contact details), and explicitly approved by the moderator before\nit may be given to a model (maintainer decision, 2026-09-25).",
      "properties": {
        "anonymised": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnonymisedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Approval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "extract": {
          "$ref": "#/$defs/Extract"
        },
        "kind": {
          "const": "brief",
          "default": "brief",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "source_format": {
          "$ref": "#/$defs/SourceFormat"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "source_format",
        "source_sha256",
        "extract",
        "provenance"
      ],
      "title": "Brief",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "levels": {
          "items": {
            "$ref": "#/$defs/Level"
          },
          "minItems": 1,
          "type": "array"
        },
        "max_points": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Percentage weight."
        }
      },
      "required": [
        "id",
        "title",
        "levels"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "EvidenceQuote": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "minLength": 1,
          "type": "string"
        },
        "verified": {
          "description": "True only if the quote was found verbatim in the approved anonymised text.",
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "verified"
      ],
      "title": "EvidenceQuote",
      "type": "object"
    },
    "Extract": {
      "additionalProperties": false,
      "description": "Text extracted locally from a source file. Never sent to a model.",
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "text",
        "source_sha256",
        "provenance"
      ],
      "title": "Extract",
      "type": "object"
    },
    "ImportRoute": {
      "enum": [
        "turnitin_bulk_zip",
        "turnitin_current_view",
        "canvas_rubric",
        "spreadsheet",
        "manual"
      ],
      "title": "ImportRoute",
      "type": "string"
    },
    "JudgementEntry": {
      "additionalProperties": false,
      "properties": {
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "comment_derived_from_ai": {
          "default": false,
          "description": "True if the comment was adapted from an AI draft.",
          "type": "boolean"
        },
        "level_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "level_id",
        "recorded_at"
      ],
      "title": "JudgementEntry",
      "type": "object"
    },
    "Level": {
      "additionalProperties": false,
      "description": "One rubric level. Use ``points`` for a single value (e.g. Turnitin rubrics)\nor ``min_mark``/``max_mark`` for a band. ``label`` is kept exactly as written.",
      "properties": {
        "descriptor": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "max_mark": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "min_mark": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "points": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "label",
        "descriptor"
      ],
      "title": "Level",
      "type": "object"
    },
    "ModelCall": {
      "additionalProperties": false,
      "description": "Provenance for one model call (ADR 0003).",
      "properties": {
        "approval_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "approved_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "cached_from_request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_reported": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_requested": {
          "minLength": 1,
          "type": "string"
        },
        "produced_by": {
          "$ref": "#/$defs/ProducedBy"
        },
        "prompt_version": {
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "response_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rubric_version": {
          "minLength": 1,
          "type": "string"
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "provider",
        "model_requested",
        "prompt_version",
        "rubric_version",
        "approval_id",
        "approved_text_sha256",
        "request_sha256",
        "produced_by",
        "timestamp"
      ],
      "title": "ModelCall",
      "type": "object"
    },
    "ModerationContext": {
      "additionalProperties": false,
      "description": "Module-level context from the moderation request. Roles only, never names.",
      "properties": {
        "band_distribution": {
          "description": "Marked assessments per band, as reported.",
          "items": {
            "$ref": "#/$defs/BandCount"
          },
          "type": "array"
        },
        "cohort_size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Module title and code, as written."
        },
        "multiple_groups": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "programme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Programme title, as written."
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "description": "Where these values came from, e.g. entered from the moderation request."
        },
        "sample_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the sample was chosen."
        },
        "staff_roles": {
          "description": "Roles involved, e.g. 'module convener', 'marker'. Never names.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "provenance"
      ],
      "title": "ModerationContext",
      "type": "object"
    },
    "ModerationRecord": {
      "additionalProperties": false,
      "description": "Everything for one moderation, self-contained and pseudonymous.",
      "properties": {
        "ai_suggestions": {
          "items": {
            "$ref": "#/$defs/AISuggestion"
          },
          "type": "array"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approved_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModerationContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "judgements": {
          "items": {
            "$ref": "#/$defs/ModeratorJudgement"
          },
          "type": "array"
        },
        "kind": {
          "const": "moderation_record",
          "default": "moderation_record",
          "type": "string"
        },
        "original_assessments": {
          "items": {
            "$ref": "#/$defs/OriginalAssessment"
          },
          "type": "array"
        },
        "overall_comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "rubric": {
          "$ref": "#/$defs/Rubric"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "type": "string"
        },
        "submissions": {
          "items": {
            "$ref": "#/$defs/Submission"
          },
          "minItems": 1,
          "type": "array"
        },
        "verdicts": {
          "items": {
            "$ref": "#/$defs/SubmissionVerdict"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "rubric",
        "submissions",
        "provenance"
      ],
      "title": "ModerationRecord",
      "type": "object"
    },
    "ModerationRequest": {
      "additionalProperties": false,
      "description": "What the commissioning body asked to be moderated.",
      "properties": {
        "context": {
          "$ref": "#/$defs/ModerationContext"
        },
        "kind": {
          "const": "moderation_request",
          "default": "moderation_request",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "sample": {
          "items": {
            "$ref": "#/$defs/SampledSubmission"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "context",
        "sample",
        "provenance"
      ],
      "title": "ModerationRequest",
      "type": "object"
    },
    "ModeratorJudgement": {
      "additionalProperties": false,
      "description": "The moderator's own judgement for one criterion.\n\nIn ``open`` review (the default, matching usual moderation practice) the\noriginal marks, comments, and AI reading are visible throughout, and only\n``first`` is recorded.\n\nIn ``blind`` review, ``first`` is recorded before the original marks and AI\nreading are revealed; ``revised`` is optional and recorded after the reveal.\nBoth are kept.",
      "properties": {
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "first": {
          "$ref": "#/$defs/JudgementEntry"
        },
        "kind": {
          "const": "moderator_judgement",
          "default": "moderator_judgement",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/ReviewMode",
          "default": "open"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "revealed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revised": {
          "anyOf": [
            {
              "$ref": "#/$defs/JudgementEntry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "submission_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "submission_id",
        "criterion_id",
        "first",
        "provenance"
      ],
      "title": "ModeratorJudgement",
      "type": "object"

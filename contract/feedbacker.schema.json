        "start": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "minLength": 1,
          "type": "string"
        },
        "verified": {
          "description": "True only if the quote was found verbatim in the approved anonymised text.",
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "verified",
        "start",
        "end"
      ],
      "type": "object"
    },
    "Extract": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Block"
          },
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "text",
        "source_sha256",
        "blocks",
        "warnings",
        "provenance"
      ],
      "type": "object"
    },
    "ImportRoute": {
      "enum": [
        "turnitin_bulk_zip",
        "turnitin_current_view",
        "canvas_rubric",
        "spreadsheet",
        "manual"
      ],
      "type": "string"
    },
    "JudgementEntry": {
      "additionalProperties": false,

        "model_requested",
        "model_reported",
        "request_id",
        "prompt_version",
        "rubric_version",
        "approval_id",
        "approved_text_sha256",
        "brief_approval_id",
        "brief_sha256",
        "fallback_from",
        "request_sha256",
        "response_sha256",
        "stop_reason",
        "usage",
        "produced_by",
        "cached_from_request_id",
        "timestamp",
        "error"

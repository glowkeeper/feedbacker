{
  "$defs": {
    "AISuggestion": {
      "additionalProperties": false,
      "properties": {
        "call": {
          "$ref": "#/$defs/ModelCall"
        },
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "draft_comment": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceQuote"
          },
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "kind": {
          "const": "ai_suggestion",
          "default": "ai_suggestion",
          "type": "string"
        },
        "missing_evidence": {
          "default": false,
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "rationale": {
          "default": "",
          "type": "string"
        },
        "submission_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "suggested_level_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null when the model could not suggest a level."
        }
      },
      "required": [
        "kind",
        "id",
        "submission_id",
        "criterion_id",
        "suggested_level_id",
        "rationale",
        "evidence",
        "draft_comment",
        "missing_evidence",
        "call",
        "provenance"
      ],
      "type": "object"
    },
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "label": {
          "description": "Role label or model identifier, e.g. 'moderator' or a model ID.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label"
      ],
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "moderator",
        "original_marker",
        "model",
        "system"
      ],
      "type": "string"
    },
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "anchor_text": {
          "default": null,
          "description": "An approximate passage the comment refers to, if known.",
          "type": [
            "string",
            "null"
          ]
        },
        "criterion_label": {
          "default": null,
          "description": "The criterion tag on the comment, as written.",
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The marker's comment number."
        },
        "page": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "position": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "text",
        "number",
        "criterion_label",
        "anchor_text",
        "page",
        "position"
      ],
      "type": "object"
    },
    "AnonymisedText": {
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "redactions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Redaction"
          },
          "type": "array"
        },
        "text": {
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "text",
        "text_sha256",
        "redactions",
        "provenance"
      ],
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "approved_at": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        "approved_by": {
          "$ref": "#/$defs/Actor"
        },
        "approved_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "approved_text_sha256",
        "approved_by",
        "approved_at"
      ],
      "type": "object"
    },
    "BandCount": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "label",
        "count"
      ],
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/BlockKind"
        },
        "level": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Heading level, if a heading."
        },
        "page": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page number, for PDFs."
        },
        "start": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start",
        "end",
        "level",
        "page"
      ],
      "type": "object"
    },
    "BlockKind": {
      "enum": [
        "heading",
        "paragraph",
        "table_row"
      ],
      "type": "string"
    },
    "Brief": {
      "additionalProperties": false,
      "properties": {
        "anonymised": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnonymisedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Approval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "extract": {
          "$ref": "#/$defs/Extract"
        },
        "kind": {
          "const": "brief",
          "default": "brief",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "source_format": {
          "$ref": "#/$defs/SourceFormat"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }

        "prompt_version": {
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "request_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "response_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rubric_version": {
          "minLength": 1,
          "type": "string"
        },
        "stop_reason": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage",
          "default": {
            "cache_read_tokens": 0,
            "cache_write_tokens": 0,
            "input_tokens": 0,
            "output_tokens": 0
          }
        }
      },
      "required": [

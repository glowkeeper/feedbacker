{
  "name": "feedbacker-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Feedbacker's TypeScript browser core (ui/src/core, ADR 0004); the interface arrives in #19.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#pdfjs": {
      "types": "pdfjs-dist",
      "node": "pdfjs-dist/legacy/build/pdf.mjs",
      "default": "pdfjs-dist/build/pdf.mjs"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "contract": "node scripts/contract.ts",
    "contract:check": "node scripts/contract.ts --check",
    "interop": "node scripts/interop-workspace.ts && node scripts/interop-request.ts",
    "check:browser": "node scripts/check-browser.ts",
    "parity:extraction": "node scripts/parity-extraction.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.3.289",
    "saxes": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "playwright-core": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
